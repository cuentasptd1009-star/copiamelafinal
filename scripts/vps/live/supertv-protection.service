[Unit]
Description=SuperTV protección HLS en una calidad
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/supertv-protection
StateDirectory=supertv-protection
CacheDirectory=supertv-protection
Environment=LIVE_PROTECTION_ONLY=1
Environment=LIVE_PORT=8798
Environment=LIVE_MAX_CHANNELS=5
Environment=LIVE_CONFIG_FILE=/var/lib/supertv-protection/channels.json
Environment=LIVE_DIRECTORY=/var/cache/supertv-protection
ExecStart=/usr/bin/node /opt/supertv-protection/server.mjs
Restart=on-failure
RestartSec=2
CPUQuota=65%
MemoryMax=700M
Nice=15
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
